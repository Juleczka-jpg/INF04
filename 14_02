using System.IO;

namespace ConsoleApp6
{
    internal class Program
    {

        static void Main(string[] args)
        {
            string tresc;
            Console.WriteLine("Wpisz kolejne zadania do wykonania. Aby zakończyć, wpisz 'koniec'.");
           
            while (true)
            {
                tresc = Console.ReadLine();

                if (tresc.ToLower() == "koniec")
                {
                    break;
                }

                File.AppendAllText("lista_zadan.txt", tresc + Environment.NewLine);
            }

            if (File.Exists("lista_zadan.txt"))
            {
                string[] zadania = File.ReadAllLines("lista_zadan.txt");
                Console.WriteLine("\nLista zadań:");

                for (int i = 0; i < zadania.Length; i++)
                {
                    Console.WriteLine($"{i + 1}. {zadania[i]}");
                }
                Console.WriteLine($"\nLiczba zadań: {zadania.Length}");
            }
            else
            {
                Console.WriteLine("Plik z zadaniami nie istnieje.");
            }

            Console.WriteLine("\nNaciśnij dowolny klawisz, aby zakończyć...");
            Console.ReadKey();
        }
    }
}
