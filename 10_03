namespace ConsoleApp2
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int liczba;
            bool poprawne;

            do
            {
                Console.Write("\nPodaj liczbę całkowitą w zakresie 10-99: ");
                string wejscie = Console.ReadLine();

                poprawne = int.TryParse(wejscie, out liczba);

                if (!poprawne)
                {
                    Console.WriteLine("\nBłąd: należy podać liczbę całkowitą.");
                }
                else if (liczba < 10 || liczba > 99)
                {
                    Console.WriteLine("\nBłąd: liczba musi być z przedziału 10-99.");
                    poprawne = false;
                }

            } while (!poprawne);  

            Console.WriteLine($"\nDziękujemy, podano liczbę: {liczba}.");

            if (liczba % 2 == 0)
            {
                Console.WriteLine("\nPodana liczba jest parzysta.");
            }
            else
            {
                Console.WriteLine("\nPodana liczba jest nieparzysta.");
            }
        }
    }
}
