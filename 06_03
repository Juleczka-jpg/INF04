namespace ConsoleApp1
{
    internal class Program
    {
        static void Main(string[] args)
        {
            Console.Write("Ile liczb chcesz wprowadzić? ");
            int ile;
            while (!int.TryParse(Console.ReadLine(), out ile) || ile <= 0)
            {
                Console.Write("Podaj poprawną liczbę większą od 0: ");
            }

            int[] liczby = new int[ile];
            int min = 0;
            int max = 0;
            int minIndex = 0;
            int maxIndex = 0;

            for (int i = 0; i < liczby.Length; i++)
            {
                Console.Write($"Podaj {i + 1}. liczbę całkowitą: ");
                while (!int.TryParse(Console.ReadLine(), out liczby[i]))
                {
                    Console.Write("To nie jest poprawna liczba całkowita. Spróbuj ponownie: ");
                }
            }

            min = liczby[0];
            max = liczby[0];
            minIndex = 0;
            maxIndex = 0;

            for (int i = 0; i < liczby.Length; i++)
            {
                if (liczby[i] < min)
                {
                    min = liczby[i];
                    minIndex = i;
                }
                if (liczby[i] > max)
                {
                    max = liczby[i];
                    maxIndex = i;
                }
            }

            for (int i = 0; i < liczby.Length - 1; i++)
            {
                for (int j = 0; j < liczby.Length - i - 1; j++)
                {
                    if (liczby[j] < liczby[j + 1])
                    {
                        int tymczasowa = liczby[j];
                        liczby[j] = liczby[j + 1];
                        liczby[j + 1] = tymczasowa;
                    }
                }
            }

            Console.WriteLine("\nPosortowana tablica:");
            foreach (int element in liczby)
            {
                Console.Write(element + ", ");
            }
            Console.WriteLine();

            Console.WriteLine($"\nWartość najmniejsza: {min} (pozycja: {minIndex + 1})");
            Console.WriteLine($"Wartość największa: {max} (pozycja: {maxIndex + 1})");
        }
    }
}
