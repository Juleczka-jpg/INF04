namespace Zadanie3_R4
{
    internal class Program
    {
        static void Main(string[] args)
        {
            Console.Write("Podaj liczbę: ");
            int n = int.Parse(Console.ReadLine());
            int sum = 0;

            for(int i = 1; i <= n; i++)
            {
                if(i % 2 == 0)
                {
                    sum += i;
                }
            }

            Console.WriteLine($"Suma liczb parzystych od 1 do {n} wynosi: {sum}");
        }
    }
}
