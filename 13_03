namespace ConsoleApp2
{
    internal class Program
    {
        static int WczytajOcene(string komunikat)
        {
            int ocena;
            while (true)
            {
                Console.Write(komunikat);
                string tekst = Console.ReadLine();

                if (tekst.ToLower() == "koniec")
                {
                    return -1; 
                }

                if (!int.TryParse(tekst, out ocena))
                {
                    Console.WriteLine("Wprowadzona wartość nie jest liczbą.");
                    continue;
                }

                if (ocena < 1 || ocena > 6)
                {
                    Console.WriteLine($"Wartość musi mieścić się w zakresi 1-6.");
                    continue;
                }

                return ocena;
            }
        }

        static void Main(string[] args)
        {
            List<int> oceny = new List<int>();

            Console.WriteLine("Wpisz oceny od 1 do 6. Aby zakończyć, wpisz 'koniec'.");

            while (true)
            {
                int ocena = WczytajOcene("Podaj ocenę (1–6) lub napisz 'koniec': ");

                if (ocena == -1)
                {
                    break;
                }

                oceny.Add(ocena);
            }

            if (oceny.Count > 0)
            {
                double srednia = 0;
                foreach (int ocena in oceny)
                {
                    srednia += ocena;
                }
                srednia /= oceny.Count;

                Console.WriteLine($"\nLiczba wprowadzonych ocen: {oceny.Count}");
                Console.WriteLine($"Średnia ocen: {srednia:F2}");
            }
            else
            {
                Console.WriteLine("Nie wprowadzono żadnych ocen.");
            }
        }
    }
}
